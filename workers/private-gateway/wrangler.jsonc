{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paul-gateway-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "preview_urls": false,
  "services": [
    {
      "binding": "BACKEND",
      "service": "kalender-proxy"
    },
    {
      "binding": "TRAILYX",
      "service": "trailyx-api-dev"
    }
  ],
  "secrets": {
    "required": ["ALLOWED_GOOGLE_EMAIL", "HUB_PREVIEW_SECRET"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
